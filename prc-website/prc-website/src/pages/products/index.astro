---
import Base from '../../layouts/Base.astro';
// TODO: extend with the full 17-product catalogue across all categories; each product gets its own landing page.
const categories = [
  { name: 'Rent & Tenancy Tools', items: [
    {
      code: 'PRC-MLR-001',
      name: 'Maintenance Request Log',
      blurb: 'Track maintenance requests, vendors, costs, and unit inventory across your properties.',
      tiers: [
        { tier: 'Landlord', price: 'GHS 49', features: '1 property, up to 15 units', href: 'https://selar.com/9380s42111' },
        { tier: 'Manager', price: 'GHS 99', features: 'Unlimited properties & units', href: 'https://selar.com/5712z42216' },
        { tier: 'Portfolio', price: 'GHS 179', features: '+ WhatsApp cards, Excel template', href: 'https://selar.com/36o104c137' }
      ]
    },
    {
      code: 'PRC-RTR-001',
      name: 'Rent Collection Tracker',
      blurb: 'Automated rent tracking with late fee calculations, arrears register, and dashboard KPIs.',
      tiers: [
        { tier: 'Landlord', price: 'GHS 49', features: 'Up to 10 units', href: 'https://selar.com/t18i981du5' },
        { tier: 'Manager', price: 'GHS 99', features: 'Unlimited + PDF guide', href: 'https://selar.com/g2x1377cmx' },
        { tier: 'Portfolio', price: 'GHS 179', features: '+ WhatsApp cards', href: 'https://selar.com/8873100u71' }
      ]
    },
    {
      code: 'PRC-TSC-001',
      name: 'Tenant Screening Checklist & Scorecard',
      blurb: 'Comprehensive 25-point scorecard with risk categories, verification checklist, and decision page.',
      tiers: [
        { tier: 'Basic', price: 'GHS 49', features: 'Printable & Fillable PDF', href: 'https://selar.com/8q9f34t894' },
        { tier: 'Pro', price: 'GHS 99', features: '+ Excel workbook, Word template', href: 'https://selar.com/7q48h4a47a' },
        { tier: 'Agency', price: 'GHS 199', features: '+ 5 WhatsApp cards', href: 'https://selar.com/64464k1414' }
      ]
    }
  ]},
  { name: 'Property Management Systems', items: [
    {
      code: 'PRC-PIC-001',
      name: 'Ghana Property Inspection Checklist',
      blurb: 'Comprehensive 60-item inspection with automated register, color-coded ratings, and cost tracking.',
      tiers: [
        { tier: 'Landlord', price: 'GHS 39', features: 'Fillable PDF checklist', href: 'https://selar.com/0n237w0851' },
        { tier: 'Manager', price: 'GHS 79', features: '+ Interactive app, Excel register', href: 'https://selar.com/10e07c38m5' },
        { tier: 'Portfolio', price: 'GHS 139', features: '+ WhatsApp cards', href: 'https://selar.com/bb4331eeuz' }
      ]
    },
    {
      code: 'PRC-UT-001',
      name: 'Utility Payment Tracker',
      blurb: 'Track water, electricity, and gas payments across multiple units with automated summaries.',
      tiers: [
        { tier: 'Basic', price: 'GHS 49', features: 'Up to 10 tenants', href: 'https://selar.com/i143w9r719' },
        { tier: 'Pro', price: 'GHS 99', features: 'Unlimited tenants + PDF guide', href: 'https://selar.com/oaj57wf56u' },
        { tier: 'Agency', price: 'GHS 179', features: '+ Full bundle + WhatsApp cards', href: 'https://selar.com/8373w348v1' }
      ]
    }
  ]},
  { name: 'Document & Agreement Templates', items: [
    {
      code: 'PRC-LA-PACK-001',
      name: 'Ghana Lease Agreement Template Pack',
      blurb: 'Complete set of lease agreements for residential, commercial, month-to-month, and room rentals.',
      tiers: [
        { tier: 'Basic', price: 'GHS 49', features: '2 agreements (DOCX + PDF)', href: 'https://selar.com/68rdh61h87' },
        { tier: 'Pro', price: 'GHS 99', features: '4 agreements (DOCX + PDF)', href: 'https://selar.com/13bi2h25kh' },
        { tier: 'Agency', price: 'GHS 199', features: '5 agreements + Excel tracker + WhatsApp cards', href: 'https://selar.com/238385f830' }
      ]
    },
    {
      code: 'PRC-CS-PACK-001',
      name: 'Landlord Communication Scripts Pack',
      blurb: 'Ready-to-use scripts for rent reminders, inspections, maintenance, and tenant relations.',
      tiers: [
        { tier: 'Basic', price: 'GHS 29', features: '2 scripts (formal + WhatsApp)', href: 'https://selar.com/385q56339p' },
        { tier: 'Pro', price: 'GHS 49', features: '4 scripts (formal + WhatsApp)', href: 'https://selar.com/215vd95328' }
      ]
    }
  ]},
  { name: 'Advisory & Education', items: [
    {
      code: 'PRC-EVG-001',
      name: 'Legal Eviction Process in Ghana E-Book',
      blurb: 'Plain-language guide to legal eviction under Act 220 (Rent Act 1963). 12 chapters, step-by-step process.',
      tiers: [
        { tier: 'E-Book', price: 'GHS 89', features: '12 chapters, HTML + PDF + WhatsApp cards', href: 'https://selar.com/0e9417p776' }
      ]
    }
  ]},
];
---
<Base title="Digital Products" description="Act 220-compliant tenancy agreements, leases, notices, and property tools for Ghana — from Property and Rent Consult.">
  <section class="section">
    <div class="wrap">
      <span class="cite">The PRC catalogue</span>
      <h1>Documents and tools that hold up.</h1>
      <p class="muted" style="max-width:680px;">Every product is grounded in the Rent Act, 1963 (Act 220) and L.I. 369, and shaped by frontline experience in rent administration, valuation, and property management.</p>
      {categories.map(c => c.items.length > 0 && (
        <div style="margin-top:2.5rem;">
          <h2>{c.name}</h2>
          <div class="grid grid-3">
            {c.items.map(p => (
              <div class="card">
                <span class="tag">{p.code}</span>
                <h3 style="font-size:1.1rem;">{p.name}</h3>
                <p class="small muted">{p.blurb}</p>
                {p.tiers && p.tiers.length > 0 ? (
                  <div style="margin-top:1rem;">
                    {p.tiers.map(tier => (
                      <div style="margin-bottom:1rem; padding:1rem; background:#f0f4f8; border-radius:6px; border-left:4px solid #516784;">
                        <p style="margin:0 0 0.5rem 0; font-weight:700; font-size:1rem; color:#362622;">{tier.tier}</p>
                        <p style="margin:0.25rem 0 0.5rem 0; font-size:0.85rem; color:#666;">{tier.features}</p>
                        <p style="margin:0.75rem 0 1rem 0; font-weight:700; font-size:1.2rem; color:#516784;">{tier.price}</p>
                        <a href={tier.href} target="_blank" class="btn btn-primary" style="display:block; text-align:center; padding:0.75rem; background:#516784; color:white; text-decoration:none; border-radius:4px; font-weight:600; font-size:1rem;">Get {tier.tier === 'E-Book' ? 'Now' : tier.tier} on Selar →</a>
                      </div>
                    ))}
                  </div>
                ) : (
                  <>
                    <p><strong>{p.price}</strong></p>
                    <a href={p.href}>View details →</a>
                  </>
                )}
              </div>
            ))}
          </div>
        </div>
      ))}
      <div class="notice" style="margin-top:2.5rem; max-width:720px;">More products from the Rent &amp; Tenancy Tools, Property Management Systems, and Advisory &amp; Education categories are being added. <a href="/contact/">Ask about a product</a> or follow the Knowledge Hub for release notes.</div>
    </div>
  </section>
</Base>
