---
import Base from '../../layouts/Base.astro';
---
<Base title="The Tenant's Rights Pocket Guide — Free Download" description="Act 220, condensed to a ten-minute read: what your landlord can ask for, what they can't, and what to do when the line is crossed.">
  <section class="section">
    <div class="wrap" style="max-width:680px;">
      <span class="cite">Free download</span>
      <h1>The Tenant's Rights Pocket Guide</h1>
      <p class="muted">What your landlord can ask for, what they can't, and what to do when the line is crossed — the Rent Act, 1963 (Act 220), condensed to a guide you can read in ten minutes.</p>
      <form class="card" name="lead-magnet" method="POST" data-netlify="true">
        <input type="hidden" name="form-name" value="lead-magnet" />
        <p><label for="email">Email address</label><input id="email" type="email" name="email" required placeholder="you@example.com" /></p>
        <p><button class="btn btn-primary" type="submit">Send me the guide</button></p>
        <p class="small muted">We send guidance, not noise. Unsubscribe any time. <a href="/privacy/">Privacy notice</a> applies.</p>
      </form>
      <p class="small muted" style="margin-top:1rem;">[Connect this form to your email provider and attach the PDF in the welcome email before launch.]</p>
    </div>
  </section>
</Base>
