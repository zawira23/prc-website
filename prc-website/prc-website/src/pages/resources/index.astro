---
import Base from '../../layouts/Base.astro';
---
<Base title="Resources" description="Free tools and references for Ghanaian tenants and landlords: the nationwide Rent Control office directory, rent advance calculator, and FAQs.">
  <section class="section">
    <div class="wrap">
      <span class="cite">Free tools &amp; references</span>
      <h1>Resources</h1>
      <p class="muted" style="max-width:680px;">The practical layer: look up your Rent Control office, check a figure, download a guide.</p>
      <div class="grid grid-2" style="margin-top:2rem;">
        <a class="card" style="text-decoration:none;display:block;" href="/resources/rent-control-offices/">
          <span class="tag">Directory</span>
          <h3>Rent Control Office Directory</h3>
          <p class="small muted">65 offices across 10 regions — locations, call numbers, and GPS codes. The only published nationwide directory of its kind.</p>
        </a>
        <a class="card" style="text-decoration:none;display:block;" href="/resources/rent-advance-calculator/">
          <span class="tag">Calculator</span>
          <h3>Rent Advance Calculator</h3>
          <p class="small muted">Enter your rent and the advance demanded; see the total, the period, and how it compares to the statutory position.</p>
        </a>
        <a class="card" style="text-decoration:none;display:block;" href="/free/tenant-rights-guide/">
          <span class="tag">Free download</span>
          <h3>Tenant's Rights Pocket Guide</h3>
          <p class="small muted">Act 220, condensed to a ten-minute read. Free by email.</p>
        </a>
        <a class="card" style="text-decoration:none;display:block;" href="/knowledge/">
          <span class="tag">Guidance</span>
          <h3>Knowledge Hub</h3>
          <p class="small muted">Statute-grounded articles on advance rent, agreements, Rent Control, eviction, and compliance.</p>
        </a>
      </div>
    </div>
  </section>
</Base>
