---
import Base from '../../layouts/Base.astro';
---
<Base title="Rent Advance Calculator Ghana | Act 220 Advance Rent Limit" description="Calculate how much rent advance a landlord can legally charge in Ghana under Act 220, and what the law says if they demand more.">
  <section class="section">
    <div class="wrap">
      <span class="cite">Act 220 · Section 25(5)</span>
      <h1>Rent Advance Calculator</h1>
      <p class="muted" style="max-width:680px;">Enter the monthly rent and the advance being demanded. The calculator shows the total payable, the period it covers, and how the demand compares to the statutory ceiling on advance rent.</p>

      <div class="grid grid-2" style="margin-top:2rem; align-items:start;">
        <form class="card" id="calc" onsubmit="return false;">
          <p>
            <label for="rent">Monthly rent (GHS)</label>
            <input id="rent" type="number" min="1" step="any" placeholder="e.g. 1500" />
          </p>
          <p>
            <label for="months">Advance demanded (months)</label>
            <input id="months" type="number" min="1" max="120" step="1" placeholder="e.g. 24" />
          </p>
          <p>
            <label for="type">Tenancy payment interval</label>
            <select id="type">
              <option value="6">Paid monthly or longer interval (statutory ceiling: 6 months)</option>
              <option value="1">Paid weekly / shorter than monthly (statutory ceiling: 1 month)</option>
            </select>
          </p>
          <p><button class="btn btn-primary" id="go" type="button">Calculate</button></p>
        </form>

        <div class="card" id="result" hidden>
          <h3 style="margin-top:0;">Result</h3>
          <p><strong>Total advance payable:</strong> <span id="total"></span></p>
          <p><strong>Period covered:</strong> <span id="period"></span></p>
          <p id="verdict" class="notice" style="border-left-color: var(--steel);"></p>
          <p class="small muted">Statutory reference: Rent Act, 1963 (Act 220), s. 25(5). This calculator is general information, not legal advice. Read the full guide: <a href="/knowledge/advance-rent-ghana-act-220/">How Much Advance Rent Is Legal in Ghana?</a></p>
          <p><a class="btn btn-ghost" href="/products/residential-tenancy-agreement/">Get the compliant tenancy agreement →</a></p>
        </div>
      </div>
    </div>
  </section>

  <script>
    const ghs = n => 'GHS ' + n.toLocaleString('en-GH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    document.getElementById('go').addEventListener('click', () => {
      const rent = parseFloat(document.getElementById('rent').value);
      const months = parseInt(document.getElementById('months').value, 10);
      const ceiling = parseInt(document.getElementById('type').value, 10);
      if (!rent || !months || rent <= 0 || months <= 0) return;
      document.getElementById('total').textContent = ghs(rent * months);
      document.getElementById('period').textContent = months + (months === 1 ? ' month' : ' months')
        + (months >= 12 ? ' (' + (months / 12).toFixed(months % 12 === 0 ? 0 : 1) + ' year' + (months > 12 ? 's' : '') + ')' : '');
      const v = document.getElementById('verdict');
      if (months <= ceiling) {
        v.textContent = 'This demand is within the statutory ceiling of ' + ceiling + ' month' + (ceiling > 1 ? 's' : '') + ' for this tenancy type.';
      } else {
        v.textContent = 'This demand exceeds the statutory ceiling of ' + ceiling + ' month' + (ceiling > 1 ? 's' : '')
          + ' for this tenancy type by ' + (months - ceiling) + ' month' + (months - ceiling > 1 ? 's' : '')
          + ' — equivalent to ' + ghs(rent * (months - ceiling)) + ' beyond the Act 220 position.';
      }
      document.getElementById('result').hidden = false;
    });
  </script>
</Base>
