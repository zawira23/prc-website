---
import Base from '../../layouts/Base.astro';
---
<Base title="Consultancy Services" description="Five service categories, 24 advisory services — grounded in Ghana's Rent Act, 1963 (Act 220). Written advice, fixed scope, transparent pricing.">

  <!-- ── HERO ─────────────────────────────────────────────── -->
  <section class="svc-hero">
    <div class="wrap">
      <span class="cite svc-cite">Consultancy Services</span>
      <h1 class="svc-h1">Expert guidance for every stage of your property journey.</h1>
      <p class="svc-sub">From rent assessment to legal eviction — PRC provides structured, evidence-based advisory services grounded in Ghana's Rent Act, 1963 (Act 220).</p>
      <div class="svc-ctas">
        <a href="#quote-form" class="btn btn-steel svc-cta-js" data-target="quote-form" data-focus="qf-name">Request a Service</a>
        <a href="#service-categories" class="btn btn-outline-paper svc-cta-js" data-target="service-categories">View All Services</a>
      </div>
      <div class="svc-stats">
        <div class="svc-stat"><span class="svc-stat-num">5</span><span class="svc-stat-label">Service Categories</span></div>
        <div class="svc-stat"><span class="svc-stat-num">24+</span><span class="svc-stat-label">Advisory Services</span></div>
        <div class="svc-stat"><span class="svc-stat-num svc-stat-sm">Act 220</span><span class="svc-stat-label">Legal Grounding</span></div>
        <div class="svc-stat"><span class="svc-stat-num svc-stat-sm">Same Day</span><span class="svc-stat-label">Dispute Response</span></div>
        <div class="svc-stat"><span class="svc-stat-num svc-stat-sm">Written</span><span class="svc-stat-label">Every Delivery</span></div>
      </div>
    </div>
  </section>

  <!-- ── POSITIONING BAND ──────────────────────────────────── -->
  <section class="svc-band">
    <div class="wrap svc-band-inner">
      <div class="svc-band-line"></div>
      <p class="svc-band-quote">"PRC provides end-to-end property advisory and management solutions, helping landlords, tenants, investors, and institutions maximise property value, maintain compliance, reduce risks, and achieve sustainable rental performance in Ghana."</p>
      <p class="svc-band-attr">— Property and Rent Consult</p>
    </div>
  </section>

  <!-- ── CATEGORY OVERVIEW ─────────────────────────────────── -->
  <section id="service-categories" class="section">
    <div class="wrap">
      <span class="cite">What we do</span>
      <h2 style="max-width:560px;">Five service categories. One trusted advisory practice.</h2>
      <p class="muted" style="max-width:560px; margin-bottom:2.5rem;">Whether you need a rent assessment, help navigating the Rent Control Department, or a full compliance audit — our services are structured, evidence-based, and grounded in Ghanaian property law.</p>

      <div class="svc-cat-grid">
        <a href="#tenancy-rent" class="svc-cat-card svc-cta-js" data-target="tenancy-rent">
          <div class="svc-cat-top">
            <div class="svc-cat-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#516984" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7.5" cy="15.5" r="5.5"/><path d="M21 8.5l-7.5 7.5"/><path d="M16 3l5 5-2.5 2.5L13.5 5.5z"/></svg>
            </div>
            <span class="svc-cat-num">01</span>
          </div>
          <h3 class="svc-cat-name">Tenancy &amp; Rent Services</h3>
          <p class="svc-cat-desc">Advisory on rent assessment, tenancy drafting, lease renewal, and lawful recovery of unpaid rent — grounded in Act 220 and L.I. 369.</p>
          <div class="svc-cat-foot">
            <span class="tag">5 services</span>
            <span class="svc-view-link">View services →</span>
          </div>
        </a>

        <a href="#property-operations" class="svc-cat-card svc-cta-js" data-target="property-operations">
          <div class="svc-cat-top">
            <div class="svc-cat-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#516984" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94z"/></svg>
            </div>
            <span class="svc-cat-num">02</span>
          </div>
          <h3 class="svc-cat-name">Property Operations &amp; Maintenance</h3>
          <p class="svc-cat-desc">Structured support for inspections, maintenance coordination, utility management, and renovation supervision across your portfolio.</p>
          <div class="svc-cat-foot">
            <span class="tag">5 services</span>
            <span class="svc-view-link">View services →</span>
          </div>
        </a>

        <a href="#advisory-compliance" class="svc-cat-card svc-cta-js" data-target="advisory-compliance">
          <div class="svc-cat-top">
            <div class="svc-cat-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#516984" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
            </div>
            <span class="svc-cat-num">03</span>
          </div>
          <h3 class="svc-cat-name">Advisory &amp; Compliance</h3>
          <p class="svc-cat-desc">Compliance audits, Rent Control advisory, health and safety assessments, and investment due diligence for landlords and investors.</p>
          <div class="svc-cat-foot">
            <span class="tag">5 services</span>
            <span class="svc-view-link">View services →</span>
          </div>
        </a>

        <a href="#dispute-representation" class="svc-cat-card svc-cta-js" data-target="dispute-representation">
          <div class="svc-cat-top">
            <div class="svc-cat-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#516984" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="3" x2="12" y2="21"/><path d="M7 21h10"/><path d="M4 8l4 8H4M23 8l-4 8h4"/><path d="M8 8h8"/></svg>
            </div>
            <span class="svc-cat-num">04</span>
          </div>
          <h3 class="svc-cat-name">Dispute &amp; Representation</h3>
          <p class="svc-cat-desc">Pre-lodgement dispute preparation, mediation support, court documentation, and direct representation before the Rent Control Department.</p>
          <div class="svc-cat-foot">
            <span class="tag">4 services</span>
            <span class="svc-view-link">View services →</span>
          </div>
        </a>

        <a href="#training-digital" class="svc-cat-card svc-cta-js" data-target="training-digital">
          <div class="svc-cat-top">
            <div class="svc-cat-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#516984" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c0 2 2 3 6 3s6-1 6-3v-5"/></svg>
            </div>
            <span class="svc-cat-num">05</span>
          </div>
          <h3 class="svc-cat-name">Training &amp; Digital Solutions</h3>
          <p class="svc-cat-desc">Landlord and tenant education, property record digitisation, management system setup, and standard operating procedure development.</p>
          <div class="svc-cat-foot">
            <span class="tag">5 services</span>
            <span class="svc-view-link">View services →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ── TENANCY & RENT SERVICES ───────────────────────────── -->
  <section id="tenancy-rent" class="svc-acc-section svc-acc-tint">
    <div class="wrap svc-acc-inner">
      <div class="svc-acc-left">
        <div class="svc-acc-deco">01</div>
        <h2 class="svc-acc-title">Tenancy &amp; Rent Services</h2>
        <p class="svc-acc-desc muted">Advisory on rent assessment, tenancy drafting, lease renewal, and lawful recovery of unpaid rent — grounded in Act 220 and L.I. 369.</p>
        <button class="btn btn-steel svc-request-btn" data-cat="Tenancy &amp; Rent Services">Request this service</button>
      </div>
      <div class="svc-acc-right">
        <ul class="acc-list" role="list">
          <li class="acc-item">
            <button class="acc-header" aria-expanded="false" aria-controls="acc-tr-1">
              <span class="acc-name">Rent Assessment Advisory</span>
              <span class="acc-right"><span class="acc-fee">GHS 200 – 400</span><svg class="acc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></span>
            </button>
            <div class="acc-panel" id="acc-tr-1" role="region">
              <div class="acc-body">
                <p class="acc-desc">A written, evidence-based advisory on the rent your premises can lawfully and defensibly command — prepared before you serve any increase or commencement notice. Includes comparable market analysis and a concluded rent range referenced to Act 220 and L.I. 369. Delivered as a formal PDF advisory report.</p>
                <div class="acc-meta"><div><p class="acc-meta-label">Turnaround</p><p class="acc-meta-val">2–3 working days</p></div><div><p class="acc-meta-label">Fee</p><p class="acc-meta-val">GHS 200 – 400</p></div></div>
                <button class="acc-request-link" data-cat="Tenancy &amp; Rent Services" data-svc="Rent Assessment Advisory">Request this service →</button>
              </div>
            </div>
          </li>
          <li class="acc-item">
            <button class="acc-header" aria-expanded="false" aria-controls="acc-tr-2">
              <span class="acc-name">Tenancy Agreement Drafting</span>
              <span class="acc-right"><span class="acc-fee">GHS 350 – 600</span><svg class="acc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></span>
            </button>
            <div class="acc-panel" id="acc-tr-2" role="region">
              <div class="acc-body">
                <p class="acc-desc">A bespoke tenancy agreement drafted for your specific premises, parties, and agreed terms — grounded in Act 220 and current Ghanaian practice. Covers fixed-term, month-to-month, room rental, commercial, and kiosk/container tenancies. One round of revisions included. Delivered in Word and PDF.</p>
                <div class="acc-meta"><div><p class="acc-meta-label">Turnaround</p><p class="acc-meta-val">2–3 working days</p></div><div><p class="acc-meta-label">Fee</p><p class="acc-meta-val">GHS 350 – 600</p></div></div>
                <button class="acc-request-link" data-cat="Tenancy &amp; Rent Services" data-svc="Tenancy Agreement Drafting">Request this service →</button>
              </div>
            </div>
          </li>
          <li class="acc-item">
            <button class="acc-header" aria-expanded="false" aria-controls="acc-tr-3">
              <span class="acc-name">Rent Collection &amp; Recovery</span>
              <span class="acc-right"><span class="acc-fee">GHS 250 / session</span><svg class="acc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></span>
            </button>
            <div class="acc-panel" id="acc-tr-3" role="region">
              <div class="acc-body">
                <p class="acc-desc">Structured advisory on lawful rent collection procedures, arrears management, and the formal recovery process under Act 220 — including the correct sequence of warning notices, formal demand letters, and Rent Control referral. Includes a personalised arrears recovery action plan.</p>
                <div class="acc-meta"><div><p class="acc-meta-label">Turnaround</p><p class="acc-meta-val">By appointment</p></div><div><p class="acc-meta-label">Fee</p><p class="acc-meta-val">GHS 250 per session</p></div></div>
                <button class="acc-request-link" data-cat="Tenancy &amp; Rent Services" data-svc="Rent Collection &amp; Recovery">Request this service →</button>
              </div>
            </div>
          </li>
          <li class="acc-item">
            <button class="acc-header" aria-expanded="false" aria-controls="acc-tr-4">
              <span class="acc-name">Lease Renewal Management</span>
              <span class="acc-right"><span class="acc-fee">GHS 200 – 350</span><svg class="acc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></span>
            </button>
            <div class="acc-panel" id="acc-tr-4" role="region">
              <div class="acc-body">
                <p class="acc-desc">Advisory and documentation support for tenancy renewals — including review of existing terms, preparation of a renewal offer letter, negotiation guidance, and drafting of the renewal agreement. Ensures compliance with L.I. 369 notice requirements for any rent revision.</p>
                <div class="acc-meta"><div><p class="acc-meta-label">Turnaround</p><p class="acc-meta-val">2–3 working days</p></div><div><p class="acc-meta-label">Fee</p><p class="acc-meta-val">GHS 200 – 350</p></div></div>
                <button class="acc-request-link" data-cat="Tenancy &amp; Rent Services" data-svc="Lease Renewal Management">Request this service →</button>
              </div>
            </div>
          </li>
          <li class="acc-item">
            <button class="acc-header" aria-expanded="false" aria-controls="acc-tr-5">
              <span class="acc-name">Eviction Guidance</span>
              <span class="acc-right"><span class="acc-fee">GHS 400</span><svg class="acc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></span>
            </button>
            <div class="acc-panel" id="acc-tr-5" role="region">
              <div class="acc-body">
                <p class="acc-desc">Step-by-step written guidance on the lawful process for recovering possession of your property — covering required notices, mandatory timelines, Form 9 preparation, Rent Control Department filing, and Magistrate Court procedure. Includes draft notices where applicable.</p>
                <div class="acc-meta"><div><p class="acc-meta-label">Turnaround</p><p class="acc-meta-val">2–3 working days</p></div><div><p class="acc-meta-label">Fee</p><p class="acc-meta-val">GHS 400</p></div></div>
                <button class="acc-request-link" data-cat="Tenancy &amp; Rent Services" data-svc="Eviction Guidance">Request this service →</button>
              </div>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ── PROPERTY OPERATIONS ───────────────────────────────── -->
  <section id="property-operations" class="svc-acc-section">
    <div class="wrap svc-acc-inner">
      <div class="svc-acc-left">
        <div class="svc-acc-deco">02</div>
        <h2 class="svc-acc-title">Property Operations &amp; Maintenance</h2>
        <p class="svc-acc-desc muted">Structured support for inspections, maintenance coordination, utility management, and renovation supervision across your portfolio.</p>
        <button class="btn btn-steel svc-request-btn" data-cat="Property Operations &amp; Maintenance">Request this service</button>
      </div>
      <div class="svc-acc-right">
        <ul class="acc-list" role="list">
          <li class="acc-item">
            <button class="acc-header" aria-expanded="false" aria-controls="acc-po-1">
              <span class="acc-name">Property Inspections</span>
              <span class="acc-right"><span class="acc-fee">GHS 400 – 800</span><svg class="acc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></span>
            </button>
            <div class="acc-panel" id="acc-po-1" role="region">
              <div class="acc-body">
                <p class="acc-desc">On-site or document-based inspection with a written advisory report covering structural condition, electrical and plumbing assessment, pest findings, and recommendations — suitable for move-in, routine, move-out, and pre-letting inspections. Report can serve as evidence in Rent Control or court proceedings.</p>
                <div class="acc-meta"><div><p class="acc-meta-label">Turnaround</p><p class="acc-meta-val">2–4 working days</p></div><div><p class="acc-meta-label">Fee</p><p class="acc-meta-val">GHS 400 – 800</p></div></div>
                <button class="acc-request-link" data-cat="Property Operations &amp; Maintenance" data-svc="Property Inspections">Request this service →</button>
              </div>
            </div>
          </li>
          <li class="acc-item">
            <button class="acc-header" aria-expanded="false" aria-controls="acc-po-2">
              <span class="acc-name">Maintenance Coordination</span>
              <span class="acc-right"><span class="acc-fee">GHS 250 / hour</span><svg class="acc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></span>
            </button>
            <div class="acc-panel" id="acc-po-2" role="region">
              <div class="acc-body">
                <p class="acc-desc">Structured support in identifying, scoping, and coordinating maintenance works across one or more properties — including vendor sourcing, cost benchmarking, work order preparation, and completion verification. Particularly useful for absent landlords and portfolio managers.</p>
                <div class="acc-meta"><div><p class="acc-meta-label">Turnaround</p><p class="acc-meta-val">By appointment</p></div><div><p class="acc-meta-label">Fee</p><p class="acc-meta-val">GHS 250 per hour</p></div></div>
                <button class="acc-request-link" data-cat="Property Operations &amp; Maintenance" data-svc="Maintenance Coordination">Request this service →</button>
              </div>
            </div>
          </li>
          <li class="acc-item">
            <button class="acc-header" aria-expanded="false" aria-controls="acc-po-3">
              <span class="acc-name">Preventive Maintenance Planning</span>
              <span class="acc-right"><span class="acc-fee">GHS 300 – 700</span><svg class="acc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></span>
            </button>
            <div class="acc-panel" id="acc-po-3" role="region">
              <div class="acc-body">
                <p class="acc-desc">A property-specific preventive maintenance schedule covering electrical, plumbing, structural, roofing, and compound systems — with recommended inspection intervals, estimated costs, and a prioritised action list. Delivered as a written maintenance plan document.</p>
                <div class="acc-meta"><div><p class="acc-meta-label">Turnaround</p><p class="acc-meta-val">3–5 working days</p></div><div><p class="acc-meta-label">Fee</p><p class="acc-meta-val">GHS 300 – 700</p></div></div>
                <button class="acc-request-link" data-cat="Property Operations &amp; Maintenance" data-svc="Preventive Maintenance Planning">Request this service →</button>
              </div>
            </div>
          </li>
          <li class="acc-item">
            <button class="acc-header" aria-expanded="false" aria-controls="acc-po-4">
              <span class="acc-name">Renovation Supervision</span>
              <span class="acc-right"><span class="acc-fee">GHS 500 – 1,500</span><svg class="acc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></span>
            </button>
            <div class="acc-panel" id="acc-po-4" role="region">
              <div class="acc-body">
                <p class="acc-desc">Advisory and supervisory support for renovation and refurbishment projects — including scope of works review, contractor assessment, progress monitoring visits, and a final completion sign-off report. Fee based on project scale and number of site visits required.</p>
                <div class="acc-meta"><div><p class="acc-meta-label">Turnaround</p><p class="acc-meta-val">Project-based</p></div><div><p class="acc-meta-label">Fee</p><p class="acc-meta-val">GHS 500 – 1,500</p></div></div>
                <button class="acc-request-link" data-cat="Property Operations &amp; Maintenance" data-svc="Renovation Supervision">Request this service →</button>
              </div>
            </div>
          </li>
          <li class="acc-item">
            <button class="acc-header" aria-expanded="false" aria-controls="acc-po-5">
              <span class="acc-name">Utility Management</span>
              <span class="acc-right"><span class="acc-fee">GHS 200 – 400</span><svg class="acc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></span>
            </button>
            <div class="acc-panel" id="acc-po-5" role="region">
              <div class="acc-body">
                <p class="acc-desc">Advisory on shared utility billing, ECG/NEDCo account management, service charge structures, and utility dispute resolution between landlords and tenants. Includes a written utility management framework for shared-occupancy properties.</p>
                <div class="acc-meta"><div><p class="acc-meta-label">Turnaround</p><p class="acc-meta-val">2–3 working days</p></div><div><p class="acc-meta-label">Fee</p><p class="acc-meta-val">GHS 200 – 400</p></div></div>
                <button class="acc-request-link" data-cat="Property Operations &amp; Maintenance" data-svc="Utility Management">Request this service →</button>
              </div>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ── ADVISORY & COMPLIANCE ─────────────────────────────── -->
  <section id="advisory-compliance" class="svc-acc-section svc-acc-tint">
    <div class="wrap svc-acc-inner">
      <div class="svc-acc-left">
        <div class="svc-acc-deco">03</div>
        <h2 class="svc-acc-title">Advisory &amp; Compliance</h2>
        <p class="svc-acc-desc muted">Compliance audits, Rent Control advisory, health and safety assessments, and investment due diligence for landlords and investors.</p>
        <button class="btn btn-steel svc-request-btn" data-cat="Advisory &amp; Compliance">Request this service</button>
      </div>
      <div class="svc-acc-right">
        <ul class="acc-list" role="list">
          <li class="acc-item">
            <button class="acc-header" aria-expanded="false" aria-controls="acc-ac-1">
              <span class="acc-name">Landlord Compliance Audits</span>
              <span class="acc-right"><span class="acc-fee">GHS 500 – 1,000</span><svg class="acc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></span>
            </button>
            <div class="acc-panel" id="acc-ac-1" role="region">
              <div class="acc-body">
                <p class="acc-desc">A property-by-property review of documentation, advance rent handling, receipt practices, and notice procedures — assessed against Act 220 and L.I. 369. Delivers a written audit report and a prioritised remediation checklist identifying all areas of non-compliance.</p>
                <div class="acc-meta"><div><p class="acc-meta-label">Turnaround</p><p class="acc-meta-val">3–5 working days</p></div><div><p class="acc-meta-label">Fee</p><p class="acc-meta-val">GHS 500 – 1,000</p></div></div>
                <button class="acc-request-link" data-cat="Advisory &amp; Compliance" data-svc="Landlord Compliance Audits">Request this service →</button>
              </div>
            </div>
          </li>
          <li class="acc-item">
            <button class="acc-header" aria-expanded="false" aria-controls="acc-ac-2">
              <span class="acc-name">Rent Control Advisory</span>
              <span class="acc-right"><span class="acc-fee">GHS 250 / session</span><svg class="acc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></span>
            </button>
            <div class="acc-panel" id="acc-ac-2" role="region">
