  { name: 'Rent Increase Advisory', desc: 'Written guidance on whether a proposed rent increase is lawful, how much you can increase under Act 220, and the proper notice procedure.', price: 'GHS 250', time: '2 working days', slug: '/services/rent-increase-advisory/' },
  { name: 'Tenancy Agreement Drafting', desc: 'Custom drafting of a residential, commercial, furnished, or month-to-month lease fully compliant with Act 220 and L.I. 369.', price: 'GHS 350 – 600', time: '2–3 working days', slug: '/services/tenancy-agreement-drafting/' },
  { name: 'Property Inspection & Advisory Report', desc: 'Professional property inspection with condition assessment, photographic record, cost-to-repair estimates, and a written advisory report.', price: 'GHS 400 – 800', time: '2–4 working days', slug: '/services/property-inspection-advisory-report/' },
  { name: 'Property Management Consultation', desc: 'Hourly consultation on rent policy, tenant relations, property maintenance schedules, compliance, and operational best practices.', price: 'GHS 250 per hour', time: 'By appointment', slug: '/services/property-management-consultation/' },
  { name: 'Property Record Review & Setup', desc: 'Audit of your existing property records and setup of a compliant documentation system for leases, tenants, payments, and notices.', price: 'GHS 300 – 700', time: '2–5 working days', slug: '/services/property-record-review-setup/' },
  { name: 'Eviction and Recovery of Possession Guidance', desc: 'Step-by-step guidance on the legal eviction process under Act 220, including notice service, Form 9 preparation, and Rent Magistrate procedure.', price: 'GHS 400', time: '2–3 working days', slug: '/services/eviction-recovery-guidance/' },
  { name: 'Rental Market Analysis Report', desc: 'Market research report on comparable rental rates in your location, property type, and tenure — data-driven positioning for rent-setting.', price: 'GHS 500 – 1,000', time: '3–5 working days', slug: '/services/rental-market-analysis-report/' },
