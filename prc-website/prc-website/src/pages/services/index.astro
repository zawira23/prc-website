const services = [
  { name: 'Rent Assessment Advisory', desc: 'Evidence-based written position on the lawful, defensible rent for your premises under Act 220 and L.I. 369 — delivered before you serve notice.', price: 'GHS 200 – 400', time: '2–3 working days', slug: '/services/rent-assessment-advisory/' },
  { name: 'Tenancy Documentation Review', desc: 'Your lease, offer letter, or notice reviewed line-by-line against Act 220 compliance, with marked corrections and a summary of gaps.', price: 'GHS 150 per agreement', time: '1–2 working days', slug: '/services/tenancy-documentation-review/' },
  { name: 'Landlord Compliance Audit', desc: 'Full property-by-property review of your documentation, advance handling, rent receipts, and notice practices — with remediation checklist.', price: 'GHS 500 – 1,000', time: '3–5 working days', slug: '/services/landlord-compliance-audit/' },
