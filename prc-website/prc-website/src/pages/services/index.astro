        <strong>Scope of PRC's services.</strong> PRC advises and prepares documentation. PRC does not appear for or represent parties in Rent Control proceedings, and engagement of PRC confers no advantage in any matter before any Rent Control office. Content and advisories are professional guidance, not legal advice.
      </div>
    </div>
  </section>

  <!-- ── SCRIPTS ────────────────────────────────────────────── -->
  <script>
    // Services per category
    const CAT_SERVICES = {
      'Tenancy & Rent Services': ['Rent Assessment Advisory','Tenancy Agreement Drafting','Rent Collection & Recovery','Lease Renewal Management','Eviction Guidance'],
      'Property Operations & Maintenance': ['Property Inspections','Maintenance Coordination','Preventive Maintenance Planning','Renovation Supervision','Utility Management'],
      'Advisory & Compliance': ['Landlord Compliance Audits','Rent Control Advisory','Health & Safety Assessments','Property Due Diligence','Investment Advisory'],
      'Dispute & Representation Services': ['Dispute Guidance','Mediation Services','Court Documentation Support','Landlord Representation'],
      'Training & Digital Solutions': ['Landlord Training','Tenant Orientation','Property Record Digitisation','Property Management System Setup','SOP Development']
    };

    function scrollToId(id, focusId) {
      const el = document.getElementById(id);
      if (!el) return;
      const offset = 72;
      const top = el.getBoundingClientRect().top + window.scrollY - offset;
      window.scrollTo({ top, behavior: 'smooth' });
      if (focusId) {
        setTimeout(() => { const f = document.getElementById(focusId); if (f) f.focus(); }, 500);
      }
    }

    // Smooth-scroll links
    document.querySelectorAll('.svc-cta-js').forEach(function(el) {
      el.addEventListener('click', function(e) {
        e.preventDefault();
        scrollToId(this.dataset.target, this.dataset.focus);
      });
    });

    // Category cards → section scroll
    document.querySelectorAll('.svc-cat-card').forEach(function(card) {
      card.addEventListener('click', function(e) {
        e.preventDefault();
        scrollToId(this.dataset.target);
      });
      card.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); scrollToId(this.dataset.target); }
      });
    });

    // Accordion
    document.querySelectorAll('.acc-list').forEach(function(list) {
      const items = list.querySelectorAll('.acc-item');
      const headers = list.querySelectorAll('.acc-header');

      headers.forEach(function(btn, i) {
        btn.addEventListener('click', function() {
          const item = items[i];
          const isOpen = item.classList.contains('open');
          // Close all in this list
          items.forEach(function(it) {
            it.classList.remove('open');
            it.querySelector('.acc-header').setAttribute('aria-expanded', 'false');
          });
          // Toggle clicked
          if (!isOpen) {
            item.classList.add('open');
            btn.setAttribute('aria-expanded', 'true');
          }
        });
        // Arrow key navigation
        btn.addEventListener('keydown', function(e) {
          if (e.key === 'ArrowDown' && headers[i + 1]) { e.preventDefault(); headers[i + 1].focus(); }
          if (e.key === 'ArrowUp' && headers[i - 1])   { e.preventDefault(); headers[i - 1].focus(); }
        });
      });
    });

    // Dynamic service dropdown
    const catSelect = document.getElementById('qf-category');
    const svcSelect = document.getElementById('qf-service');

    function populateServices(catVal) {
      const services = CAT_SERVICES[catVal] || [];
      if (services.length) {
        svcSelect.innerHTML = '<option value="">Select a service</option>' +
          services.map(function(s) { return '<option value="' + s + '">' + s + '</option>'; }).join('');
        svcSelect.disabled = false;
      } else {
        svcSelect.innerHTML = '<option value="">Select a category first</option>';
        svcSelect.disabled = true;
      }
    }

    catSelect.addEventListener('change', function() { populateServices(this.value); });

    // Pre-fill form from "Request this service" buttons
    function prefillForm(cat, svc) {
      scrollToId('quote-form', 'qf-name');
      setTimeout(function() {
        if (cat && catSelect) {
          catSelect.value = cat;
          populateServices(cat);
          if (svc && svcSelect) {
            setTimeout(function() { svcSelect.value = svc; }, 100);
          }
        }
      }, 400);
    }

    document.querySelectorAll('.svc-request-btn, .acc-request-link').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var cat = this.dataset.cat || '';
        var svc = this.dataset.svc || '';
        // Decode HTML entities
        cat = cat.replace(/&amp;/g, '&');
        svc = svc.replace(/&amp;/g, '&');
        prefillForm(cat, svc);
      });
    });

    // Form submission
    const form = document.getElementById('consultation-form');
    const submitBtn = document.getElementById('qf-submit');
    const successPanel = document.getElementById('qf-success');
    const firstNameSpan = document.getElementById('qf-firstname');
    const errorMsg = document.getElementById('qf-form-error');

    form.addEventListener('submit', function(e) {
      e.preventDefault();
      errorMsg.style.display = 'none';

      // Validate required fields
      var valid = true;
      form.querySelectorAll('[required]').forEach(function(field) {
        if (!field.value.trim()) { valid = false; field.style.borderColor = '#c0392b'; }
        else { field.style.borderColor = ''; }
      });

      if (!valid) { errorMsg.style.display = 'block'; return; }

      // Simulate submission
      submitBtn.textContent = 'Sending…';
      submitBtn.disabled = true;

      setTimeout(function() {
        var nameVal = document.getElementById('qf-name').value.trim();
        firstNameSpan.textContent = nameVal.split(' ')[0] || 'there';
        form.style.display = 'none';
        successPanel.style.display = 'block';
      }, 1200);
    });
  </script>

  <!-- ── STYLES ─────────────────────────────────────────────── -->
  <style>
    /* Hero */
    .svc-hero { background: var(--ink); padding: 4rem 0 0; }
    .svc-cite { color: #a0b4c8; border-color: #a0b4c8; }
    .svc-h1 { color: #fff; max-width: 700px; font-size: clamp(1.9rem, 4vw, 3rem); }
    .svc-sub { color: rgba(246,243,238,0.85); max-width: 600px; font-size: 1.05rem; line-height: 1.7; margin-bottom: 2rem; }
    .svc-ctas { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 3rem; }
    .btn-steel { background: var(--steel); border-color: var(--steel); color: #fff; }
    .btn-steel:hover { background: var(--steel-dark); border-color: var(--steel-dark); color: #fff; }
    .btn-outline-paper { background: transparent; border-color: var(--paper); color: var(--paper); }
    .btn-outline-paper:hover { background: rgba(246,243,238,0.1); color: var(--paper); }

    /* Stats bar */
    .svc-stats { display: grid; grid-template-columns: repeat(5, 1fr); gap: .75rem; background: rgba(0,0,0,0.2); margin: 0 -1.25rem; padding: 1.5rem 1.25rem; }
    .svc-stat { text-align: center; }
    .svc-stat-num { display: block; font-family: "Fraunces", Georgia, serif; font-size: 2.2rem; font-weight: 600; color: #fff; line-height: 1; margin-bottom: .3rem; }
    .svc-stat-sm { font-size: 1.1rem; padding-top: .6rem; }
    .svc-stat-label { display: block; font-size: .75rem; color: rgba(246,243,238,0.7); letter-spacing: .04em; line-height: 1.3; }
    @media (max-width: 760px) {
      .svc-stats { grid-template-columns: repeat(5, minmax(110px, 1fr)); overflow-x: auto; scrollbar-width: none; }
      .svc-stats::-webkit-scrollbar { display: none; }
    }

    /* Positioning band */
    .svc-band { background: var(--tint); padding: 3.5rem 0; }
    .svc-band-inner { max-width: 720px; text-align: center; }
    .svc-band-line { width: 3px; height: 40px; background: var(--ink); margin: 0 auto 1.5rem; }
    .svc-band-quote { font-family: "Fraunces", Georgia, serif; font-size: clamp(1rem, 2vw, 1.2rem); font-style: italic; color: var(--ink); line-height: 1.7; margin-bottom: 1rem; }
    .svc-band-attr { font-size: .85rem; color: var(--grey); }

    /* Category cards */
    .svc-cat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
    .svc-cat-grid .svc-cat-card:nth-child(4),
    .svc-cat-grid .svc-cat-card:nth-child(5) { grid-column: span 1; }
    /* Centre last 2 on desktop using offset trick */
    @media (min-width: 761px) {
      .svc-cat-grid { grid-template-columns: repeat(6, 1fr); }
      .svc-cat-card { grid-column: span 2; }
      .svc-cat-card:nth-child(4) { grid-column: 2 / span 2; }
      .svc-cat-card:nth-child(5) { grid-column: 4 / span 2; }
    }
    @media (max-width: 760px) {
      .svc-cat-grid { grid-template-columns: 1fr; }
    }

    .svc-cat-card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 4px;
      padding: 1.5rem;
      text-decoration: none;
      color: var(--ink);
      display: flex;
      flex-direction: column;
      cursor: pointer;
      transition: box-shadow .2s ease, border-color .2s ease, transform .2s ease;
    }
    .svc-cat-card:hover {
      box-shadow: 0 6px 20px rgba(54,34,28,0.1);
      border-color: var(--steel);
      transform: translateY(-2px);
      color: var(--ink);
    }
    .svc-cat-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; }
    .svc-cat-icon { width: 44px; height: 44px; background: #e8eef3; border-radius: 8px; display: flex; align-items: center; justify-content: center; }
    .svc-cat-num { font-size: .75rem; font-weight: 600; color: var(--steel); }
    .svc-cat-name { font-size: 1.05rem; font-family: "Fraunces", Georgia, serif; font-weight: 600; color: var(--ink); margin-bottom: .5rem; line-height: 1.3; }
    .svc-cat-desc { font-size: .875rem; color: var(--grey); line-height: 1.6; flex-grow: 1; margin-bottom: 1.25rem; }
    .svc-cat-foot { display: flex; align-items: center; justify-content: space-between; }
    .svc-view-link { font-size: .8rem; font-weight: 600; color: var(--steel); }

    /* Accordion sections */
    .svc-acc-section { padding: 4rem 0; }
    .svc-acc-tint { background: var(--tint); }
    .svc-acc-inner { display: grid; grid-template-columns: 28% 1fr; gap: 4rem; align-items: start; }
    @media (max-width: 900px) { .svc-acc-inner { grid-template-columns: 1fr; gap: 2rem; } }

    .svc-acc-left { position: sticky; top: 72px; }
    @media (max-width: 900px) { .svc-acc-left { position: static; } }
    .svc-acc-deco { font-family: "Fraunces", Georgia, serif; font-size: 4rem; font-weight: 600; color: rgba(54,34,28,0.08); line-height: 1; margin-bottom: .25rem; }
    .svc-acc-title { font-size: clamp(1.3rem, 2.5vw, 1.7rem); margin-bottom: .75rem; }
    .svc-acc-desc { font-size: .9rem; line-height: 1.7; margin-bottom: 1.5rem; }

    /* Accordion items */
    .acc-list { list-style: none; display: flex; flex-direction: column; gap: .5rem; padding: 0; margin: 0; }
    .acc-item {}
    .acc-header {
      width: 100%;
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 3px;
      padding: 1rem 1.25rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      font-family: inherit;
      font-size: inherit;
      text-align: left;
      color: var(--ink);
      transition: border-color .15s, border-radius .15s;
    }
    .acc-item.open .acc-header { border-bottom-left-radius: 0; border-bottom-right-radius: 0; border-color: var(--steel); }
    .acc-name { font-size: .95rem; font-weight: 600; }
    .acc-right { display: flex; align-items: center; gap: 1rem; flex-shrink: 0; margin-left: 1rem; }
    .acc-fee { font-size: .85rem; color: var(--steel); white-space: nowrap; }
    .acc-chevron { color: var(--grey); transition: transform .2s ease; flex-shrink: 0; }
    .acc-item.open .acc-chevron { transform: rotate(180deg); }

    .acc-panel { max-height: 0; overflow: hidden; transition: max-height .3s ease; }
    .acc-item.open .acc-panel { max-height: 800px; }
    .acc-body {
      background: var(--paper);
      border: 1px solid var(--steel);
      border-top: none;
      border-bottom-left-radius: 3px;
      border-bottom-right-radius: 3px;
      padding: 1.25rem;
    }
    .acc-desc { font-size: .9rem; color: var(--grey); line-height: 1.7; margin-bottom: 1rem; }
    .acc-meta { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem; padding: .75rem; background: var(--tint); border-radius: 2px; }
    .acc-meta-label { font-size: .7rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--grey); margin-bottom: .2rem; }
    .acc-meta-val { font-size: .875rem; color: var(--ink); font-weight: 600; }
    .acc-request-link { background: none; border: none; padding: 0; cursor: pointer; font-size: .875rem; font-weight: 600; color: var(--steel); font-family: inherit; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
    .acc-request-link:hover { color: var(--ink); }

    /* Steps */
    .svc-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; margin-top: 2.5rem; }
    @media (max-width: 760px) { .svc-steps { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 480px) { .svc-steps { grid-template-columns: 1fr; } }
    .svc-step-num {
      width: 44px; height: 44px; border-radius: 50%;
      border: 2px solid var(--ink);
      display: flex; align-items: center; justify-content: center;
      font-family: "Fraunces", Georgia, serif;
      font-weight: 600; font-size: .95rem;
      color: var(--ink); margin-bottom: 1rem;
    }
    .svc-step-title { font-size: 1rem; margin-bottom: .5rem; }

    /* Form section */
    .svc-form-section { background: var(--ink); padding: 4.5rem 0; }
    .svc-form-title { color: #fff; margin-bottom: .5rem; }
    .svc-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1rem; }
    @media (max-width: 540px) { .svc-form-row { grid-template-columns: 1fr; } }
    #consultation-form input:focus, #consultation-form select:focus, #consultation-form textarea:focus {
      outline: 3px solid var(--steel); outline-offset: 1px; border-color: var(--steel);
    }

    /* Mobile fee hide on narrow screens */
    @media (max-width: 480px) { .acc-fee { display: none; } }
  </style>
